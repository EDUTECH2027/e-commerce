# Copy to .env or set in your hosting dashboard. All optional.
PORT=3001
# First-run owner account (only used when no users exist yet)
ADMIN_EMAIL=owner@yourstore.com
ADMIN_PASSWORD=choose-a-long-password
# Public address, used in link previews, sitemap and WhatsApp product links
PUBLIC_URL=https://www.yourstore.com
# Set to 1 when behind nginx / a hosting proxy
TRUST_PROXY=1
# Where database and uploads live (default ./data)
# DATA_DIR=/var/data/store
# Fixed session secret (otherwise generated and stored in data/.jwt-secret)
# JWT_SECRET=
