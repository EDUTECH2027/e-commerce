# Copy to .env for local development. Every value is optional locally.
# On Vercel set these in Project -> Settings -> Environment Variables (see DEPLOY.md).

PORT=3001

# First-run owner account (only used while the database has no users yet)
ADMIN_EMAIL=owner@yourstore.com
ADMIN_PASSWORD=choose-a-long-password

# Secret that signs admin sessions. Optional: if unset, one is generated and kept in the database.
# JWT_SECRET=

# Public address, used in link previews, the sitemap and WhatsApp product links
# PUBLIC_URL=https://www.yourstore.com

# --- Provided automatically by Vercel when you connect Neon and Blob; leave empty locally ---
# Locally the app uses a built-in PostgreSQL (PGlite, stored in ./data/pg) and saves photos in ./data/uploads.
# DATABASE_URL=
# BLOB_READ_WRITE_TOKEN=

# Where local data lives (default ./data)
# DATA_DIR=
